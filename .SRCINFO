	optdepends = bibata-cursor-theme: cursor theme selected by the desktop configuration
	optdepends = cc-switch-bin: optional application started by the personal Niri configuration
	optdepends = clash-verge-rev-bin: optional application started by the personal Niri configuration
	optdepends = fonts-apple: PingFang and Monaco font fallback
	optdepends = kitty: terminal emulator used by Niri keybindings and Fuzzel
	optdepends = libqalculate: provides qalc for the Fuzzel calculator script
	optdepends = otf-apple-sf-pro: SF Pro font family used by the desktop configuration
	optdepends = pavucontrol: audio control panel opened from Waybar
	optdepends = thunar: file manager used by Niri keybindings
	optdepends = wlogout: power menu opened from Waybar
	optdepends = whitesur-icon-theme-git: icon theme used by Fuzzel
	optdepends = wtype: sends Shift+Insert when restoring clipboard history
	provides = niri=26.4.0
	provides = sni-watcher=0.3.0
	provides = wayland-compositor
	provides = xwayland-satellite=0.8.3
	conflicts = niri
